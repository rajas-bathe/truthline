{
  "manifest_version": 3,
  "name": "TRUTHLINE AI — Don't Just Forward. Verify.",
  "short_name": "TruthLine AI",
  "version": "1.0.0",
  "description": "Multimodal AI fact-checker & claim verification pipeline for WhatsApp Web and open web content.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "TruthLine AI Verifier"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://web.whatsapp.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content/whatsapp.js"
      ],
      "css": [
        "content/whatsapp.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png",
        "panel/panel.html"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ]
}
