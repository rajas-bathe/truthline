# ==============================================================================
# TRUTHLINE AI — Environment Configuration Template
# Copy this file to '.env' in the project root or in 'server/'
# NEVER commit your actual '.env' file with real secrets to source control.
# ==============================================================================

PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,chrome-extension://*

# Core API Keys
GEMINI_API_KEY=
TAVILY_API_KEY=
GOOGLE_FACTCHECK_API_KEY=

# Security & Sessions
# Random 32+ character secret used to sign session tokens
SESSION_SECRET=truthline_development_secret_change_in_production_999888
# Rate limiting: max verification requests per 15 minutes per session
RATE_LIMIT_MAX_REQUESTS=60

# File Upload Constraints
# Max upload size in megabytes (Images, Audio, PDF)
MAX_FILE_SIZE_MB=15
# Max audio duration allowed for verification (in seconds)
MAX_AUDIO_DURATION_SECONDS=180

# Cache & Storage
DATABASE_PATH=./data/truthline.db
CACHE_TTL_HOURS=24
HISTORY_RETENTION_DAYS=30
